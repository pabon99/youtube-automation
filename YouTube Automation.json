    {
      "parameters": {
        "jsCode": "const inputJson = $input.first().json;\nconst script = String(inputJson.Script || inputJson.text || inputJson.output || \"\").replace(/\\s+/g, \" \").trim();\nif (!script) throw new Error(\"Script field is empty.\");\n\nconst TOTAL_PARTS = 4;\nconst CHUNK_DURATION = 8;\nconst words = script.split(/\\s+/).filter(Boolean);\nif (words.length < TOTAL_PARTS) throw new Error(`Script has only ${words.length} words; need at least ${TOTAL_PARTS}.`);\n\n// Balance the narration across exactly four 8-second scenes.\nconst baseSize = Math.floor(words.length / TOTAL_PARTS);\nconst remainder = words.length % TOTAL_PARTS;\nconst chunks = [];\nlet wordIndex = 0;\n\nfor (let i = 0; i < TOTAL_PARTS; i++) {\n  const size = baseSize + (i < remainder ? 1 : 0);\n  const chunkWords = words.slice(wordIndex, wordIndex + size);\n  chunks.push({\n    index: i,\n    text: chunkWords.join(\" \"),\n    wordCount: chunkWords.length,\n    start: i * CHUNK_DURATION,\n    end: (i + 1) * CHUNK_DURATION,\n    duration: CHUNK_DURATION,\n  });\n  wordIndex += size;\n}\n\nreturn chunks.map(chunk => ({ json: chunk }));"
      },
