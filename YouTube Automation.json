    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst urls = Array.isArray(input.videoUrls) ? input.videoUrls : [];\nif (urls.length !== 4) {\n  throw new Error(`Expected exactly 4 generated video URLs, received ${urls.length}.`);\n}\n\nconst CLIP_DURATION = 8;\nconst clips = urls.map((url, i) => ({\n  asset: { type: \"video\", src: url },\n  start: i * CLIP_DURATION,\n  length: CLIP_DURATION,\n}));\n\nreturn [{\n  json: {\n    timeline: {\n      tracks: [{ clips }]\n    },\n    output: {\n      format: \"mp4\",\n      fps: 30,\n      size: {\n        width: 1280,\n        height: 720\n      }\n    }\n  }\n}];"
      },
